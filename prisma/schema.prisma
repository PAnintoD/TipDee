generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH MODELS (NextAuth.js v5 / Auth.js)
// ==========================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String?
  name            String?
  image           String?
  role            String    @default("STREAMER") // ADMIN | STREAMER | VIEWER
  active          Boolean   @default(true)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  streamer        Streamer?
  auditLogs       AuditLog[]
  verificationTokens VerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  userId     String?
  identifier String
  token      String   @unique
  type       String   @default("EMAIL_VERIFY") // EMAIL_VERIFY | PASSWORD_RESET
  expires    DateTime
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // LOGIN | LOGOUT | CHANGE_PASSWORD | CHANGE_PROMPTPAY | CHANGE_SETTINGS | etc.
  detail     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ==========================================
// STREAMER MODELS
// ==========================================

model Streamer {
  id               String          @id @default(cuid())
  userId           String          @unique
  username         String          @unique
  displayName      String
  bio              String?
  avatarUrl        String?
  bannerUrl        String?
  promptpayTarget  String?
  promptpayName    String?
  truemoneyPhone   String?
  minAmount        Float           @default(5)
  presetAmounts    String          @default("[20,50,100,300,500,1000]")
  socialLinks      String?
  widgetToken      String          @default("widget_token_abc123")
  enableAutoSlip   Boolean         @default(true)
  slipApiKey       String?
  slipBranchId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations        Donation[]
  widgetSettings   WidgetSettings?
  goalSettings     GoalSettings?
}

model Donation {
  id            String    @id
  streamerId    String
  donorName     String
  amount        Float
  message       String?
  paymentMethod String    // 'promptpay' | 'truemoney' | 'slip' | 'test'
  paymentRef    String?
  status        String    @default("pending") // 'completed' | 'pending' | 'failed'
  enableTTS     Boolean   @default(true)
  isTest        Boolean   @default(false)
  slipImage     String?
  slipRef       String?
  slipHash      String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  streamer      Streamer  @relation(fields: [streamerId], references: [id], onDelete: Cascade)
}

model WidgetSettings {
  id                String   @id @default(cuid())
  streamerId        String   @unique
  template          String   @default("{name} โดเนท {amount} บาท: {message}")
  minAmountForAlert Float    @default(5)
  minAmountForTTS   Float    @default(10)
  duration          Int      @default(7)
  soundUrl          String   @default("levelup")
  soundVolume       Int      @default(80)
  imageUrl          String   @default("https://media.giphy.com/media/MDJ9IbxxvDUQM/giphy.gif")
  ttsEnabled        Boolean  @default(true)
  ttsVoice          String   @default("th-TH")
  ttsSpeed          Float    @default(1.0)
  ttsPitch          Float    @default(1.0)
  ttsVolume         Int      @default(90)
  textColor         String   @default("#ffffff")
  highlightColor    String   @default("#22c55e")

  streamer          Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
}

model GoalSettings {
  id              String   @id @default(cuid())
  streamerId      String   @unique
  title           String   @default("🎯 เป้าหมายการโดเนท")
  targetAmount    Float    @default(1000)
  currentAmount   Float    @default(0)
  endDate         String?
  barColor        String   @default("#22c55e")
  backgroundColor String   @default("rgba(15, 23, 42, 0.85)")
  textColor       String   @default("#ffffff")
  showPercentage  Boolean  @default(true)

  streamer        Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
}
